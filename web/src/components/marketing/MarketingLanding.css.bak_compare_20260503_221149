/* ===== SECCIÓN CLIENTES / CONFIANZA ===== */

.intap-trust-strip {
  width: 100%;
  padding: 42px 0 52px;
  background: #ffffff;
  border-top: 1px solid rgba(15, 23, 42, 0.06);
  border-bottom: 1px solid rgba(15, 23, 42, 0.06);
  overflow: hidden;
}

.intap-trust-inner {
  width: 100%;
}

.intap-trust-kicker {
  max-width: 760px;
  margin: 0 auto 24px;
  padding: 0 18px;
  text-align: center;
  color: #667085;
  font-size: 0.98rem;
  font-weight: 700;
  line-height: 1.45;
}

.intap-logo-marquee {
  width: 100%;
  overflow: hidden;
  position: relative;
}

.intap-logo-marquee::before,
.intap-logo-marquee::after {
  content: "";
  position: absolute;
  top: 0;
  width: 120px;
  height: 100%;
  z-index: 2;
  pointer-events: none;
}

.intap-logo-marquee::before {
  left: 0;
  background: linear-gradient(90deg, #ffffff, rgba(255,255,255,0));
}

.intap-logo-marquee::after {
  right: 0;
  background: linear-gradient(270deg, #ffffff, rgba(255,255,255,0));
}

.intap-logo-track {
  display: flex;
  align-items: center;
  gap: 18px;
  width: max-content;
  animation: intapMarquee 28s linear infinite;
}

.intap-logo-track span {
  min-width: 170px;
  height: 64px;
  padding: 0 26px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(15, 23, 42, 0.09);
  border-radius: 18px;
  background: #ffffff;
  color: #111827;
  font-size: 1rem;
  font-weight: 850;
  letter-spacing: -0.02em;
  box-shadow: 0 12px 34px rgba(15, 23, 42, 0.045);
}

.intap-logo-track span:nth-child(3n + 1) {
  color: #0b5cff;
}

.intap-logo-track span:nth-child(3n + 2) {
  color: #0b1020;
}

.intap-logo-track span:nth-child(3n + 3) {
  color: #25a76b;
}

@keyframes intapMarquee {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

@media (max-width: 640px) {
  .intap-trust-strip {
    padding: 34px 0 42px;
  }

  .intap-trust-kicker {
    font-size: 0.9rem;
    margin-bottom: 18px;
  }

  .intap-logo-track {
    gap: 12px;
    animation-duration: 22s;
  }

  .intap-logo-track span {
    min-width: 138px;
    height: 56px;
    border-radius: 15px;
    font-size: 0.9rem;
  }

  .intap-logo-marquee::before,
  .intap-logo-marquee::after {
    width: 54px;
  }
}

/* ===== SECCIÓN TARJETAS EN MOVIMIENTO — CLEAN FINAL ===== */

.intap-card-lanes-section {
  max-width: 1240px;
  margin: 0 auto;
  padding: clamp(72px, 9vw, 128px) clamp(18px, 4vw, 40px);
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
  gap: clamp(32px, 5vw, 76px);
  align-items: center;
  background: #ffffff !important;
  overflow: hidden;
}

.intap-card-lanes-copy {
  background: #ffffff !important;
  position: relative;
  z-index: 4;
}

.intap-card-lanes-copy h2 {
  max-width: 560px;
  font-size: clamp(2.25rem, 4.6vw, 4.3rem);
  line-height: 1.04;
  letter-spacing: -0.055em;
  font-weight: 680;
  color: #0b1020;
}

.intap-card-lanes-copy p:not(.eyebrow) {
  max-width: 520px;
  margin: 22px 0 0;
  color: #667085;
  font-size: clamp(1.05rem, 1.35vw, 1.25rem);
  line-height: 1.58;
}

/* Marco externo: RECTANGULAR, recto, blanco puro */
.intap-card-lanes-frame {
  position: relative !important;
  height: 570px !important;
  overflow: hidden !important;
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 18px !important;
  padding: 0 !important;
  border: 0 !important;
  border-radius: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  background: #ffffff !important;
  transform: none !important;
}

/* Eliminar cualquier fade, gris, sombra o capa vieja */
.intap-card-lanes-frame::before,
.intap-card-lanes-frame::after {
  display: none !important;
  content: none !important;
  background: transparent !important;
}

/* Carriles internos: se inclinan, pero el marco queda recto */
.intap-card-lane {
  position: relative !important;
  height: 140% !important;
  min-height: 140% !important;
  overflow: visible !important;
  background: #ffffff !important;
  transform: rotate(-7deg) scale(1.12) !important;
  transform-origin: center center !important;
}

.intap-card-lane:nth-child(1) {
  margin-top: -92px !important;
}

.intap-card-lane:nth-child(2) {
  margin-top: -150px !important;
}

.intap-card-lane:nth-child(3) {
  margin-top: -112px !important;
}

/* Track blanco, sin fondos grises */
.intap-card-track {
  display: flex !important;
  flex-direction: column !important;
  gap: 22px !important;
  width: 100% !important;
  background: #ffffff !important;
  will-change: transform !important;
}

/* Tarjetas: PNG limpio sobre blanco */
.intap-card-track img {
  width: 100% !important;
  height: auto !important;
  display: block !important;
  border-radius: 16px !important;
  background: transparent !important;
  transform: none !important;
  box-shadow: 0 18px 34px rgba(15, 23, 42, 0.13) !important;
}

/* Movimiento continuo y visible */
.lane-up .intap-card-track {
  animation: intapCardsMoveUp 22s linear infinite !important;
}

.lane-up.slow .intap-card-track {
  animation: intapCardsMoveUp 25s linear infinite !important;
}

.lane-down .intap-card-track {
  animation: intapCardsMoveDown 24s linear infinite !important;
}

/* Nunca pausar al mouse */
.intap-card-lanes-frame:hover .intap-card-track,
.intap-card-lane:hover .intap-card-track,
.intap-card-track:hover {
  animation-play-state: running !important;
}

@keyframes intapCardsMoveUp {
  0% {
    transform: translate3d(0, 0, 0);
  }

  100% {
    transform: translate3d(0, -50%, 0);
  }
}

@keyframes intapCardsMoveDown {
  0% {
    transform: translate3d(0, -50%, 0);
  }

  100% {
    transform: translate3d(0, 0, 0);
  }
}

/* Tablet */
@media (max-width: 1050px) {
  .intap-card-lanes-section {
    grid-template-columns: 1fr;
  }

  .intap-card-lanes-copy h2,
