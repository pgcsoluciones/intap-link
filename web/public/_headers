# Prevent Cloudflare edge from caching index.html so aliases like
# main.intap-web.pages.dev always serve the latest deployed version.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Kawvo Demo: las rutas SPA deben resolver siempre contra el HTML del release actual.
/demo
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/demo/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
